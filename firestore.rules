rules_version = '2';
// Browsers only READ (real-time listeners). Every write goes through the Saathi API, which checks workspace and membership.
// Workspace isolation: the API sets custom claims {org_id, org_role} on each user's ID token.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myOrg() { return request.auth.token.org_id; }
    function isGuest() { return request.auth.token.org_role == 'guest'; }

    match /orgs/{orgId} {
      allow read: if signedIn() && myOrg() == orgId;
    }
    // Directory: your own profile, or people in your workspace (guests get co-members from the API instead).
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || (resource.data.org_id == myOrg() && !isGuest()));
    }
    match /user_settings/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }
    // Chats and channels: members only. Membership is only ever granted inside the member's workspace.
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      match /messages/{msgId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      }
    }
    match /files/{fileId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
    }
    match /tasks/{taskId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
    }
    match /meetings/{meetingId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
    }
    // Connected-app data is personal: only the person who connected the account can read it
    match /events/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /external_items/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
    // Plant records: reporter, owner and the quality team only
    match /records/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
    }
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /assistant/{uid}/messages/{id} {
      allow read: if signedIn() && request.auth.uid == uid;
    }
    // Voice transcripts (text only; audio is never stored): private to the speaker, deleted after 30 days (TTL on expire_at)
    match /voice_sessions/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
    // Research runs and their live progress: only the person who ran them (shared copies live on chat messages)
    match /research_runs/{runId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      match /events/{eventId} {
        allow read: if signedIn() && get(/databases/$(database)/documents/research_runs/$(runId)).data.uid == request.auth.uid;
      }
    }
    // invites, connections, chunks, audit_log, and anything else: server only
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
